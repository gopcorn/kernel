{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "tag-separator": "/",
  "include-v-in-tag": true,
  "separate-pull-requests": true,
    "packages": {
    "sdk":         { "component": "sdk",         "release-as": "0.1.0" },
    "kernel":      { "component": "kernel",      "release-as": "0.1.0" },
    "client":      { "component": "client",      "release-as": "0.1.0" },
    "adapters":    { "component": "adapters",    "release-as": "0.1.0" },
    "conformance": { "component": "conformance", "release-as": "0.1.0" }
  }
}
